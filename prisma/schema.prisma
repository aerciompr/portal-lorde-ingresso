// Lorde Nelson Ingressos - Modern Ticket Portal
// Banco: MySQL (EasyPanel / produção)
// Campos longos usam @db.Text — VARCHAR(191) estoura com HTML de descrição

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Event {
  id                String    @id @default(cuid())
  slug              String    @unique @db.VarChar(191)
  title             String    @db.VarChar(500)
  description       String?   @db.LongText
  date              DateTime
  openTime          String?   @db.VarChar(32)
  address           String    @default("Rua Silvério Jorge, 241, Jaraguá, Maceió - AL, 57022-110") @db.VarChar(500)
  location          String?   @db.VarChar(255)
  imageUrl          String?   @db.Text
  salesDeadline     DateTime?
  footerNotice      String?   @db.Text
  /**
   * true = não aparece na home / programação pública.
   * Continua acessível pelo link direto /evento/[slug] (exclusivo / convite).
   */
  hidden            Boolean   @default(false)
  allowCancel       Boolean   @default(true)
  cancelHoursBefore Int       @default(24)
  cancelFeePercent  Float     @default(10.0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lotes              Lote[]  @relation("EventToLotes")
  activeLoteId       String? @unique @db.VarChar(191)
  activeLote         Lote?   @relation("EventToActiveLote", fields: [activeLoteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  loteAcrescimoCents Int     @default(500)
  loteDefaultQty     Int     @default(50)

  ticketTypes       TicketType[]
  orders            Order[]
  promoCodes        PromoCode[]
  loteViradas       LoteViradaLog[]
  loyaltyRedemptions LoyaltyRedemption[]
}

model TicketType {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(255)
  description String?   @db.Text
  priceCents  Int
  totalQty    Int
  sold        Int       @default(0)
  salesEndAt  DateTime?

  tickets Ticket[]

  @@index([eventId])
}

model Order {
  id                String    @id @default(cuid())
  eventId           String
  event             Event     @relation(fields: [eventId], references: [id])
  buyerName         String    @db.VarChar(255)
  buyerEmail        String    @db.VarChar(255)
  buyerCpf          String?   @db.VarChar(32)
  buyerPhone        String?   @db.VarChar(32)
  buyerPasswordHash String?   @db.VarChar(255)
  /** Endereço (cartão / Stripe billing) */
  buyerZip          String?   @db.VarChar(16)
  buyerStreet       String?   @db.VarChar(255)
  buyerNumber       String?   @db.VarChar(32)
  buyerComplement   String?   @db.VarChar(128)
  buyerNeighborhood String?   @db.VarChar(128)
  buyerCity         String?   @db.VarChar(128)
  buyerState        String?   @db.VarChar(8)
  totalCents        Int
  status            String    @default("pending") @db.VarChar(32)
  paymentGateway    String?   @db.VarChar(64)
  paymentId         String?   @db.VarChar(191)
  paymentMethod     String?   @db.VarChar(64)
  accessCode        String?   @unique @db.VarChar(64)
  createdAt         DateTime  @default(now())
  paidAt            DateTime?
  /** Último e-mail de ingresso/confirmação enviado com sucesso */
  emailSentAt       DateTime?

  loteId     String?
  lote       Lote?   @relation(fields: [loteId], references: [id], onDelete: SetNull)
  grossCents Int     @default(0)
  netCents   Int     @default(0)
  feeCents   Int     @default(0)
  feeDetails String? @db.VarChar(255)

  /** portal = pedido novo; woocommerce = importado do site antigo */
  source            String  @default("portal") @db.VarChar(32)
  /** ID do pedido no WooCommerce (shop_order) */
  externalId        String? @db.VarChar(64)
  /**
   * false = cliente NÃO pode pedir cancelamento no portal
   * (padrão para migração Woo — estorno Stripe/MP antigo não é confiável daqui)
   */
  allowClientCancel Boolean @default(true)

  /** Cupom aplicado no checkout */
  promoCodeId    String?
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeLabel String?    @db.VarChar(64)
  discountCents  Int        @default(0)

  tickets              Ticket[]
  cancellationRequests CancellationRequest[]
  logs                 OrderLog[]
  promoRedemption      PromoRedemption?
  loyaltyRedemption    LoyaltyRedemption?

  @@index([eventId])
  @@index([buyerEmail])
  @@index([status])
  @@index([source, externalId])
  @@index([promoCodeId])
}

/**
 * Histórico do pedido (admin): tentativas de pagamento, erros, e-mails, cancelamentos.
 * kind: created | pay_start | pay_ok | pay_error | paid | email | cancelled | refunded | note | client_error
 */
model OrderLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String   @db.VarChar(48)
  title     String   @db.VarChar(255)
  detail    String?  @db.Text
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([kind])
}

model Ticket {
  id           String     @id @default(cuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  uniqueCode   String     @unique @db.VarChar(64)
  qrPayload    String     @db.Text
  status       String     @default("valid") @db.VarChar(32)
  checkedInAt  DateTime?
  checkedInBy  String?    @db.VarChar(255)

  @@index([uniqueCode])
  @@index([orderId])
}

model CancellationRequest {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      String    @db.Text
  status      String    @default("pending") @db.VarChar(32)
  adminNotes  String?   @db.Text
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  @@index([orderId])
}

model Setting {
  key   String @id @db.VarChar(191)
  value String @db.LongText
}

/// Imagens do admin gravadas no MySQL — sobrevivem a deploy sem volume Docker
/// URL pública: /uploads/m/{id}
model MediaFile {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  mime      String   @db.VarChar(128)
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}

model Lote {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation("EventToLotes", fields: [eventId], references: [id], onDelete: Cascade)
  nome             String   @db.VarChar(255)
  precoCents       Int
  totalQty         Int
  sold             Int      @default(0)
  ordem            Int
  viradaAutomatica Boolean  @default(true)
  ativo            Boolean  @default(false)
  createdAt        DateTime @default(now())

  orders         Order[]
  activeForEvent Event?  @relation("EventToActiveLote")

  @@index([eventId])
}

/** Histórico de viradas de lote (auto ou manual) — feed admin + e-mail */
model LoteViradaLog {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromLoteId   String?  @db.VarChar(191)
  fromLoteNome String?  @db.VarChar(255)
  toLoteId     String   @db.VarChar(191)
  toLoteNome   String   @db.VarChar(255)
  precoCents   Int
  source       String   @db.VarChar(16) // auto | manual
  createdAt    DateTime @default(now())

  @@index([eventId])
  @@index([createdAt])
}

/**
 * Cupom promocional (vários códigos, regras de uso e desconto).
 * discountType: PERCENT | FIXED_ORDER | FIXED_PER_TICKET
 * maxUses null = ilimitado; reservedUses conta pending+paid que ainda seguram o cupom.
 */
model PromoCode {
  id                   String    @id @default(cuid())
  code                 String    @unique @db.VarChar(64)
  name                 String?   @db.VarChar(255)
  description          String?   @db.Text
  active               Boolean   @default(true)
  eventId              String?
  event                Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  discountType         String    @db.VarChar(32)
  discountValue        Int
  minTickets           Int?
  maxTicketsDiscounted Int?
  minSubtotalCents     Int?
  maxUses              Int?
  maxUsesPerEmail      Int?
  reservedUses         Int       @default(0)
  redeemedUses         Int       @default(0)
  startsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orders      Order[]
  redemptions PromoRedemption[]

  @@index([active, code])
  @@index([eventId])
}

model PromoRedemption {
  id            String    @id @default(cuid())
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerEmail    String?   @db.VarChar(255)
  discountCents Int
  ticketQty     Int
  /** reserved | applied | released */
  status        String    @db.VarChar(32)
  createdAt     DateTime  @default(now())
  appliedAt     DateTime?
  releasedAt    DateTime?

  @@index([promoCodeId, status])
  @@index([buyerEmail, promoCodeId])
}

/**
 * Usuários de staff (admin / check-in).
 * superadmin = login via ADMIN_EMAIL + ADMIN_PASSWORD no .env (não fica nesta tabela).
 * role: admin = painel admin básico; checkin = só app de check-in.
 */
model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  name         String    @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  /** admin | checkin */
  role         String    @default("checkin") @db.VarChar(32)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@index([role])
  @@index([active])
}

/**
 * Clube de fidelidade — pacote configurável (admin) de assinatura mensal.
 * checkinsPerEntry: 1 = só titular, 2 = titular + acompanhante por entrada resgatada.
 * overageDiscountPercent: desconto aplicado quando a cota de entradas grátis do ciclo já foi usada.
 * stripePriceId: Price recorrente criado manualmente no Dashboard Stripe (não gerado pelo backend).
 */
model LoyaltyPlan {
  id                     String   @id @default(cuid())
  name                   String   @db.VarChar(255)
  description            String?  @db.Text
  priceCents             Int
  freeEntriesPerCycle    Int      @default(1)
  checkinsPerEntry       Int      @default(1)
  overageDiscountPercent Int      @default(0)
  stripePriceId          String?  @db.VarChar(191)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  memberships LoyaltyMembership[]

  @@index([active])
}

/**
 * Assinatura de um cliente a um LoyaltyPlan (cartão de fidelidade).
 * status: pending | active | past_due | canceled | expired
 * entriesUsedInPeriod zera a cada renovação (currentPeriodStart avança).
 */
model LoyaltyMembership {
  id                   String    @id @default(cuid())
  planId               String
  plan                 LoyaltyPlan @relation(fields: [planId], references: [id])
  cardCode             String    @unique @db.VarChar(32)
  buyerName            String    @db.VarChar(255)
  buyerEmail           String    @db.VarChar(255)
  buyerCpf             String?   @db.VarChar(32)
  buyerPhone           String?   @db.VarChar(32)
  status               String    @default("pending") @db.VarChar(32)
  stripeCustomerId     String?   @db.VarChar(191)
  stripeSubscriptionId String?   @unique @db.VarChar(191)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  entriesUsedInPeriod  Int       @default(0)
  cardEmailSentAt      DateTime?
  createdAt            DateTime  @default(now())
  canceledAt           DateTime?

  redemptions LoyaltyRedemption[]

  @@index([buyerEmail])
  @@index([status])
  @@index([planId])
}

/** Um resgate (entrada grátis ou com desconto de excedente) usando o cartão fidelidade num evento. */
model LoyaltyRedemption {
  id                   String            @id @default(cuid())
  membershipId         String
  membership           LoyaltyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  eventId              String
  event                Event             @relation(fields: [eventId], references: [id])
  orderId              String            @unique
  order                Order             @relation(fields: [orderId], references: [id])
  withinFreeQuota      Boolean
  ticketsGranted       Int
  discountCentsApplied Int               @default(0)
  createdAt            DateTime          @default(now())

  @@index([membershipId])
  @@index([eventId])
}
