# =============================================================================
# Lorde Nelson Ingressos — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# Docs: docs/HANDOFF_COMPLETO.md · docs/DEPLOY_EASYPANEL.md
# =============================================================================

# URL pública do portal (OBRIGATÓRIO em produção — HTTPS)
NEXT_PUBLIC_APP_URL=https://portal.lordenelson.com.br

# -----------------------------------------------------------------------------
# Banco MySQL
# Local:     mysql://USER:PASS@127.0.0.1:3306/NOME_DB
# EasyPanel: host = NOME DO SERVIÇO MySQL (ex. mysql), NÃO localhost
#            mysql://portal:SENHA@mysql:3306/portal
# Senha com @ → encode como %40
# Sem aspas no valor no painel EasyPanel
# -----------------------------------------------------------------------------
DATABASE_URL=mysql://USER:SENHA@mysql:3306/portal_lorde

# EasyPanel/Docker: 0 = engine nativo Prisma (recomendado)
# cPanel/socket: 1 = adapter MariaDB JS
PRISMA_USE_ADAPTER=0

# Uploads
# UPLOAD_STORAGE=db   → grava no MySQL (recomendado; NÃO some no deploy; só env)
# UPLOAD_STORAGE=disk → pasta no container (precisa volume EasyPanel)
# UPLOAD_STORAGE=auto → tenta disco, senão MySQL
UPLOAD_STORAGE=db
UPLOADS_DIR=/app/data/uploads

# Admin (login /admin/login)
ADMIN_EMAIL=admin@lordenelson.com.br
ADMIN_PASSWORD=troque-por-senha-forte

# HMAC dos QR Codes (gere único; NÃO mude em produção sem planejar)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SECRET=

# Crons: Authorization: Bearer <CRON_SECRET>
# /api/cron/sync-payments  ·  /api/cron/cleanup-pending
CRON_SECRET=

# E-mail (Resend)
RESEND_API_KEY=
FROM_EMAIL=ingressos@lordenelson.com.br

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLIENT_ID=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
