# =============================================================================
# Lorde Nelson Ingressos — variáveis de ambiente (produção / subdomínio)
# Copie para .env e preencha. NUNCA commite o .env real.
# =============================================================================

# URL pública do portal (OBRIGATÓRIO em produção — HTTPS)
# Produção: https://portal.lordenelson.com.br
NEXT_PUBLIC_APP_URL=https://portal.lordenelson.com.br

# Banco MySQL (cPanel)
# Ex: mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO
DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO"

# Admin
ADMIN_EMAIL=admin@lordenelson.com.br
ADMIN_PASSWORD=troque-por-senha-forte

# HMAC dos QR Codes dos ingressos (gere um valor único e NÃO mude em produção)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SECRET=

# Crons (limpeza pending + sync PIX) — mesmo valor no Authorization: Bearer ...
CRON_SECRET=

# E-mail (Resend) — sem isso o e-mail de confirmação não sai
RESEND_API_KEY=
FROM_EMAIL=ingressos@lordenelson.com.br

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLIENT_ID=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Opcional
NODE_ENV=production
