{
  "name": "lordenelson-ingressos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cpanel": "node scripts/postinstall-prisma.js || true && next build --webpack",
    "start": "node server.js",
    "start:next": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/postinstall-prisma.js || true",
    "prisma:generate": "node scripts/postinstall-prisma.js",
    "db:push": "npx prisma db push --schema=./prisma/schema.prisma",
    "db:push:cpanel": "node scripts/db-push-cpanel.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=./prisma/schema.prisma",
    "admin:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prod:check": "npm run test && npm run typecheck && npm run build",
    "migrate:woocommerce": "tsx scripts/migrate-woocommerce.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-mariadb": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "@stripe/stripe-js": "^9.8.0",
    "@tiptap/extension-code-block": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.18.0",
    "mariadb": "^3.5.3",
    "mercadopago": "^3.1.0",
    "mysql2": "^3.22.5",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
